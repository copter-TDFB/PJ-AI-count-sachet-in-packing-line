# Dev-only Odoo credentials, for running from source on a developer machine.
# Copy to .env and fill in. .env is gitignored — this repo is public.
#
# Production machines do NOT use this file: operators enter the values through the
# app's 🔑 settings dialog, which stores them in
#   %LOCALAPPDATA%\odoo-counter\config.json
# (outside app/, so the launcher's auto-update never wipes them).
#
# Resolution order used by odoo_counter_app.py, all-or-nothing per source:
#   1. OS environment variables
#   2. this .env
#   3. config.json written by the settings dialog

ODOO_URL=
ODOO_DB=
ODOO_USER=
ODOO_PASSWORD=

# Test tenant, used only by test_odoo_counter_app.py (env vars or .env only —
# that clone never reads config.json, so it cannot reach a production tenant).
ODOO_TEST_URL=
ODOO_TEST_DB=
ODOO_TEST_USER=
ODOO_TEST_PASSWORD=
